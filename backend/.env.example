# JWT
JWT_SECRET=your-base64-encoded-jwt-secret-here

# Database (Spring DataSource)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=password

# Database (Docker Compose MySQL 컨테이너)
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=analysis_trend
MYSQL_USER=user
MYSQL_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# App
FRONTEND_URL=http://localhost:3000   # 운영 환경: https://yourdomain.com
COOKIE_SECURE=false                  # 운영 환경: true (HTTPS 필요)
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000  # 운영 환경: https://yourdomain.com

# OAuth2 - Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# OAuth2 - Kakao
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

# OAuth2 - Naver
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
